============================================================

Nexus Bank Environment Configuration

============================================================

IMPORTANT:

1. This file contains configuration examples only.

2. Never put real passwords, API keys, tokens, or private keys here.

3. Copy this file to .env for local development.

4. The .env file must NEVER be committed to Git.

============================================================

============================================================

APPLICATION

============================================================

APP_NAME=NexusBank
APP_ENV=development
APP_VERSION=1.0.0

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

API_BASE_URL=http://localhost:8080/api/v1

============================================================

DATABASE - POSTGRESQL

============================================================

DATABASE_HOST=localhost
DATABASE_PORT=5432

DATABASE_NAME=nexus_bank
DATABASE_USERNAME=nexus_bank_user
DATABASE_PASSWORD=CHANGE_ME

DATABASE_URL=jdbc:postgresql://localhost:5432/nexus_bank

DATABASE_POOL_MIN_SIZE=5
DATABASE_POOL_MAX_SIZE=20

============================================================

REDIS

============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

REDIS_DATABASE=0

REDIS_SESSION_TTL_SECONDS=3600
REDIS_OTP_TTL_SECONDS=300

============================================================

KAFKA

============================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

KAFKA_CONSUMER_GROUP=nexus-bank-group

KAFKA_TRANSACTION_TOPIC=bank.transactions
KAFKA_PAYMENT_TOPIC=bank.payments
KAFKA_FRAUD_TOPIC=bank.fraud
KAFKA_NOTIFICATION_TOPIC=bank.notifications
KAFKA_AUDIT_TOPIC=bank.audit

============================================================

SECURITY

============================================================

Generate a strong random value for actual deployment.

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900

JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=2592000

PASSWORD_MIN_LENGTH=12

MAX_LOGIN_ATTEMPTS=5

ACCOUNT_LOCK_DURATION_MINUTES=30

============================================================

MFA / OTP

============================================================

OTP_LENGTH=6

OTP_EXPIRATION_SECONDS=300

OTP_MAX_ATTEMPTS=5

MFA_ENABLED=true

============================================================

CORS

============================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID,X-Idempotency-Key

============================================================

FILE STORAGE

============================================================

STORAGE_PROVIDER=local

STORAGE_LOCAL_PATH=./storage

MAX_FILE_SIZE_MB=10

ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

============================================================

KYC

============================================================

KYC_DOCUMENT_MAX_SIZE_MB=10

KYC_ALLOWED_DOCUMENT_TYPES=pdf,jpg,jpeg,png

KYC_AUTO_VERIFICATION_ENABLED=false

============================================================

AI / FRAUD DETECTION

============================================================

AI_SERVICE_ENABLED=true

AI_SERVICE_URL=http://localhost:8000

AI_FRAUD_ENDPOINT=/api/v1/fraud/analyze

AI_RISK_ENDPOINT=/api/v1/risk/score

AI_REQUEST_TIMEOUT_MS=5000

FRAUD_DETECTION_ENABLED=true

============================================================

EMAIL

============================================================

EMAIL_ENABLED=false

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587

EMAIL_USERNAME=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME

EMAIL_FROM=noreply@example.com

EMAIL_TLS_ENABLED=true

============================================================

SMS

============================================================

SMS_ENABLED=false

SMS_PROVIDER=example

SMS_API_URL=https://example.com/api

SMS_API_KEY=CHANGE_ME

SMS_SENDER_ID=NEXUSB

============================================================

PUSH NOTIFICATIONS

============================================================

PUSH_NOTIFICATIONS_ENABLED=false

FCM_PROJECT_ID=CHANGE_ME
FCM_CLIENT_EMAIL=CHANGE_ME
FCM_PRIVATE_KEY=CHANGE_ME

============================================================

TRANSACTION SETTINGS

============================================================

TRANSACTION_MIN_AMOUNT=1

TRANSACTION_MAX_AMOUNT=1000000

DAILY_TRANSFER_LIMIT=500000

IDEMPOTENCY_KEY_TTL_SECONDS=86400

============================================================

BANKING SETTINGS

============================================================

DEFAULT_CURRENCY=INR

DEFAULT_COUNTRY=IN

DEFAULT_TIMEZONE=Asia/Kolkata

============================================================

INTEREST / DEPOSIT SETTINGS

============================================================

FD_ENABLED=true
RD_ENABLED=true

INTEREST_CALCULATION_MODE=DAILY

============================================================

CARD SETTINGS

============================================================

CARD_SERVICE_ENABLED=true

VIRTUAL_CARD_ENABLED=true

PHYSICAL_CARD_ENABLED=false

============================================================

AUDIT

============================================================

AUDIT_LOGGING_ENABLED=true

AUDIT_LOG_RETENTION_DAYS=2555

============================================================

API SECURITY

============================================================

RATE_LIMIT_ENABLED=true

RATE_LIMIT_REQUESTS_PER_MINUTE=100

REQUEST_BODY_MAX_SIZE_MB=2

REQUIRE_REQUEST_ID=true

============================================================

MONITORING

============================================================

METRICS_ENABLED=true

HEALTH_CHECK_ENABLED=true

PROMETHEUS_ENABLED=true

MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus

============================================================

LOGGING

============================================================

LOG_LEVEL=INFO

LOG_FILE_PATH=./logs/nexus-bank.log

SECURITY_LOG_LEVEL=INFO

AUDIT_LOG_LEVEL=INFO

============================================================

DEVELOPMENT ONLY

============================================================

DEV_MODE=true

ENABLE_TEST_DATA=false

ENABLE_SWAGGER=true

ENABLE_DEBUG_LOGGING=true

============================================================

EXTERNAL BANKING INTEGRATIONS

============================================================

These are placeholders.

Real banking/payment-network credentials must never be

committed to source control.

PAYMENT_PROVIDER_ENABLED=false

PAYMENT_PROVIDER_BASE_URL=https://example.com

PAYMENT_PROVIDER_API_KEY=CHANGE_ME

PAYMENT_PROVIDER_CLIENT_ID=CHANGE_ME

PAYMENT_PROVIDER_CLIENT_SECRET=CHANGE_ME

============================================================

BACKUP

============================================================

BACKUP_ENABLED=true

BACKUP_DIRECTORY=./backups

BACKUP_RETENTION_DAYS=30

============================================================

FEATURE FLAGS

============================================================

FEATURE_UPI=false
FEATURE_NEFT=false
FEATURE_RTGS=false

FEATURE_CARDS=true
FEATURE_LOANS=true
FEATURE_FD=true
FEATURE_RD=true

FEATURE_AI_FRAUD=true
FEATURE_AI_INSIGHTS=true
